        "messages": {
          "values": [
            {
              "content": "=You are a strict hiring assistant. You will receive resume text and a job's requirements. Respond with ONLY valid JSON, no extra text, no markdown fences, in exactly this format:\n{\"candidate_name\": \"string\", \"candidate_email\": \"string or empty if not found\", \"score\": number from 0 to 100, \"matched_skills\": [\"skill1\", \"skill2\"], \"missing_skills\": [\"skill1\", \"skill2\"], \"decision\": \"YES or NO\", \"reason\": \"one short sentence explaining the score\"}",
              "role": "system"
            },
            {
              "content": "=Job requirements: Minimum 2 years of marketing experience, proficiency in Excel and Canva, experience with social media management and campaign analytics, Bachelor's degree in Marketing or related field.\nResume text:\n{{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7d3ccc92-11ef-4821-826e-ce9fddad03ca",
      "name": "AI Check Candidate",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.5,
      "position": [
        -448,
        240
      ],
      "credentials": {
        "openAiApi": {
          "id": "geIGkKH12CXyQHUW",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Safely parse the AI's JSON reply and fall back gracefully if it's malformed\nconst raw = $input.item.json.message.content;\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    candidate_name: 'Unknown',\n    candidate_email: '',\n    score: 0,\n    matched_skills: [],\n    missing_skills: [],\n    decision: 'NO',\n    reason: 'Could not read AI response - needs manual review'\n  };\n}\n\nconst triggerData = $('Gmail Trigger').item.json;\n\nreturn {\n  json: {\n    candidate_name: parsed.candidate_name || 'Unknown',\n    candidate_email: parsed.candidate_email || (triggerData.from?.value?.[0]?.address ?? ''),\n    sender_email: triggerData.from?.value?.[0]?.address ?? '',\n    score: parsed.score ?? 0,\n    matched_skills: (parsed.matched_skills || []).join(', '),\n    missing_skills: (parsed.missing_skills || []).join(', '),\n    decision: parsed.decision || 'NO',\n    reason: parsed.reason || '',\n    applied_at: new Date().toISOString()\n  }\n};"
      },
