    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  const results = data.organicResults || [];\n\n  for (const result of results) {\n    output.push({\n      json: {\n        name: result.title\n          ? result.title.replace(/\\s*\\(@.*?\\)/, '').replace(/\\s*·.*$/, '').trim()\n          : null,\n\n        instagram_username: result.channelName || null,\n\n        instagram_url: result.url || null,\n\n        description: result.description || null,\n\n        followers: result.followersAmount || null,\n\n        position: result.position || null,\n\n        location: \"Lahore\",\n\n        source: \"Google Search\",\n\n        search_query: data.searchQuery?.term || null\n      }\n    });\n  }\n}\n\nreturn output;"
      },
